{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemap.dev/schemas/cli-investigation-v1.schema.json",
  "title": "CodeMap Investigation JSON v1",
  "type": "object",
  "required": ["version", "query", "goal", "items", "sourceSpans", "budget", "coverage", "stale", "warnings", "reason"],
  "properties": {
    "version": { "const": 1 },
    "query": { "type": "string" },
    "goal": { "enum": ["debug", "trace", "impact", "understand"] },
    "root": { "$ref": "#/$defs/match" },
    "isAmbiguous": { "type": "boolean" },
    "ambiguousCandidates": { "type": "array", "items": { "$ref": "#/$defs/match" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "sourceSpans": { "type": "array", "items": { "$ref": "#/$defs/sourceSpan" } },
    "budget": { "$ref": "#/$defs/budget" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "stale": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": ["string", "null"] },
    "error": { "$ref": "#/$defs/error" }
  },
  "$defs": {
    "match": {
      "type": "object",
      "required": ["id", "project", "kind", "name", "qualifiedName", "file", "language"],
      "properties": {
        "id": { "type": "string" }, "project": { "type": "string" }, "kind": { "type": "string" },
        "name": { "type": "string" }, "qualifiedName": { "type": "string" }, "file": { "type": "string" },
        "startLine": { "type": ["integer", "null"] }, "endLine": { "type": ["integer", "null"] },
        "language": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "required": ["symbol", "via", "depth", "provider", "alsoFoundBy"],
      "properties": {
        "symbol": { "$ref": "#/$defs/match" },
        "via": { "anyOf": [{ "$ref": "#/$defs/via" }, { "type": "null" }] },
        "depth": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string" },
        "alsoFoundBy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "via": {
      "type": "object",
      "required": ["edgeKind", "resolutionKind", "confidence", "location"],
      "properties": {
        "edgeKind": { "type": "string" }, "resolutionKind": { "enum": ["semantic", "syntactic", "heuristic"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "location": { "anyOf": [{ "type": "object" }, { "type": "null" }] }
      }
    },
    "sourceSpan": {
      "type": "object",
      "required": ["file", "startLine", "endLine", "text", "candidateIds"],
      "properties": {
        "file": { "type": "string" }, "startLine": { "type": "integer" }, "endLine": { "type": "integer" },
        "text": { "type": "string" }, "candidateIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object", "required": ["requested", "estimated", "truncated", "reason"],
      "properties": {
        "requested": { "type": "integer" }, "estimated": { "type": "integer" }, "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "coverage": {
      "type": "object",
      "required": ["providers", "remaining", "negativeEvidence"],
      "properties": {
        "providers": { "type": "array", "items": { "$ref": "#/$defs/providerCoverage" } },
        "remaining": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "negativeEvidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "providerCoverage": {
      "type": "object",
      "required": ["provider", "state", "reason", "foundCount"],
      "properties": {
        "provider": { "type": "string" },
        "state": { "enum": ["complete", "partial", "notrun", "unsupported", "unavailable", "error"] },
        "reason": { "type": ["string", "null"] },
        "foundCount": { "type": "integer", "minimum": 0 }
      }
    },
    "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}

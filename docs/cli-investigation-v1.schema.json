{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemap.dev/schemas/cli-investigation-v1.schema.json",
  "title": "CodeMap Investigation JSON v1",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "match": {
      "type": "object",
      "required": ["id", "project", "kind", "name", "qualifiedName", "file", "language"],
      "properties": {
        "id": { "type": "string" },
        "project": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "signature": { "type": ["string", "null"] },
        "file": { "type": "string" },
        "startLine": { "type": ["integer", "null"] },
        "endLine": { "type": ["integer", "null"] },
        "language": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["file", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": ["integer", "null"] },
        "startColumn": { "type": ["integer", "null"] },
        "endLine": { "type": ["integer", "null"] },
        "endColumn": { "type": ["integer", "null"] }
      }
    },
    "via": {
      "type": "object",
      "required": ["edgeKind", "resolutionKind", "confidence", "location"],
      "properties": {
        "edgeKind": { "type": "string" },
        "resolutionKind": { "enum": ["semantic", "syntactic", "heuristic"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "location": { "anyOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] }
      }
    },
    "localEvidence": {
      "type": "object",
      "required": ["scopeSymbolId", "itemId", "operationKind", "display", "file", "location", "dependencies"],
      "properties": {
        "scopeSymbolId": { "type": "string" },
        "itemId": { "type": "integer" },
        "operationKind": { "type": "string" },
        "symbolName": { "type": ["string", "null"] },
        "display": { "type": "string" },
        "file": { "type": "string" },
        "location": { "type": "object" },
        "dependencies": { "type": "array" }
      }
    },
    "item": {
      "type": "object",
      "required": ["symbol", "via", "depth", "provider", "alsoFoundBy"],
      "properties": {
        "symbol": { "$ref": "#/$defs/match" },
        "via": { "anyOf": [{ "$ref": "#/$defs/via" }, { "type": "null" }] },
        "depth": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string" },
        "alsoFoundBy": { "type": "array", "items": { "type": "string" } },
        "localEvidence": { "anyOf": [{ "$ref": "#/$defs/localEvidence" }, { "type": "null" }] }
      }
    },
    "sourceSpan": {
      "type": "object",
      "required": ["file", "startLine", "endLine", "text", "candidateIds"],
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": "integer" },
        "endLine": { "type": "integer" },
        "text": { "type": "string" },
        "candidateIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "required": ["requested", "estimated", "truncated", "reason"],
      "properties": {
        "requested": { "type": "integer" },
        "estimated": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "envelope": { "type": "integer", "minimum": 0 },
        "structural": { "type": "integer", "minimum": 0 },
        "source": { "type": "integer", "minimum": 0 },
        "totalEstimated": { "type": "integer", "minimum": 0 }
      }
    },
    "providerCoverage": {
      "type": "object",
      "required": ["provider", "state", "reason", "foundCount"],
      "properties": {
        "provider": { "type": "string" },
        "state": { "enum": ["complete", "partial", "notrun", "unsupported", "unavailable", "error"] },
        "reason": { "type": ["string", "null"] },
        "foundCount": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["providers", "remaining", "negativeEvidence"],
      "properties": {
        "providers": { "type": "array", "items": { "$ref": "#/$defs/providerCoverage" } },
        "remaining": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "negativeEvidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "required": ["version", "query", "goal", "items", "sourceSpans", "budget", "coverage", "stale", "warnings", "reason"],
      "properties": {
        "version": { "const": 1 },
        "query": { "type": "string" },
        "goal": { "enum": ["debug", "trace", "impact", "understand"] },
        "root": { "anyOf": [{ "$ref": "#/$defs/match" }, { "type": "null" }] },
        "isAmbiguous": { "type": "boolean" },
        "ambiguousCandidates": { "type": "array", "items": { "$ref": "#/$defs/match" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "sourceSpans": { "type": "array", "items": { "$ref": "#/$defs/sourceSpan" } },
        "budget": { "$ref": "#/$defs/budget" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "stale": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] },
        "error": { "type": "null" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    },
    "errorResponse": {
      "type": "object",
      "required": ["version", "query", "goal", "error", "reason", "stale"],
      "properties": {
        "version": { "const": 1 },
        "query": { "type": "string" },
        "goal": { "type": "string" },
        "error": { "$ref": "#/$defs/error" },
        "reason": { "type": "string" },
        "stale": { "type": "boolean" }
      }
    }
  }
}

<Window x:Class="WpfFixture.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfFixture.ViewModels"
        x:DataType="{x:Type vm:MainViewModel}"
        Title="MainWindow">
    <Window.Resources>
        <vm:MainViewModel x:Key="SharedViewModel" />
    </Window.Resources>
    <StackPanel DataContext="{StaticResource SharedViewModel}">
        <TextBox Text="{Binding Path=Customer.Name}" />
        <TextBox Text="{Binding CustomerName}" />
        <Button Content="Save" Click="Save_Click" Command="{Binding SaveCommand}" />
        <Button Content="Save2" Click="Save_Click" Command="{Binding Command=Save}" />
    </StackPanel>
</Window>
